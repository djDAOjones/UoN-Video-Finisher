{
  "name": "video-name-graphics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Make a lower-third name graphic, saved as transparent video for Clipchamp or a still PNG, entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=3",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tests/a11y && node ../scripts/check-projects.mjs --project tsconfig.core.json --project tsconfig.app.json --project tsconfig.test.json --project tests/a11y/tsconfig.json --entry src/root.tsx && npm run jsdoc",
    "jsdoc": "node ../scripts/jsdoc-ratchet.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "deadcode": "knip",
    "format": "prettier --write .",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "docs:links": "node check-links.mjs",
    "check": "npm run typecheck && npm run lint && npm run boundaries && npm run deadcode && npm run test && npm run docs:lint && npm run docs:links && node tools/check.mjs",
    "a11y": "node ../scripts/link-root-install.mjs . && node tools/a11y-run.mjs",
    "a11y:sample": "node ../scripts/link-root-install.mjs . && node tools/a11y-sample.mjs",
    "a11y:doctor": "node ../scripts/link-root-install.mjs . && node tools/a11y-doctor.mjs",
    "a11y:extended": "node ../scripts/link-root-install.mjs . && node tools/a11y-extended.mjs"
  },
  "dependencies": {
    "@carbon/react": "1.118.0",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@guidepup/guidepup": "0.36.4",
    "@guidepup/setup": "0.29.3",
    "@ibm/plex": "6.4.1",
    "@playwright/test": "1.56.1",
    "@types/prop-types": "15.7.15",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "knip": "6.41.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "sass": "1.105.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.2.2",
    "vitest": "5.1.0"
  }
}
