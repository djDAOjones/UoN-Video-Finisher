{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["scripts/**/*.mjs", "*.js", "*.mjs", ".*.js", ".*.mjs"]
}
