# VH-209 #1: the repairs' walks. args: label name scenarios langs views modes open focus press spacing
walkset2() { local label=$1 name=$2 scn=$3 langs=$4 views=$5 modes=$6 open=$7 focus=$8 press=$9 sp=${10} m; local -a extra; [ -n "$focus" ] && extra+=(--focus "$focus"); [ -n "$press" ] && extra+=(--press "$press"); [ -n "$sp" ] && extra+=(--spacing 1); for m in ${(s:,:)modes}; do node vh209-driver2.mjs walk --walker "$WALKER" --label "$label" --name "$name-$m" --scenarios "$scn" --langs "$langs" --views "$views" --modes "$m" --open "$open" "${extra[@]}" || echo "driver exit $? $m"; done; }
