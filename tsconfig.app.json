// The app project's layer (UVT-7): the DOM, the newer Intl libraries Carbon
// React's declarations use, React's JSX and Vite's client types.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "ES2025.Intl", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  }
}
