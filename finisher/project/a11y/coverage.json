{
  "catalogue": 1,
  "level": "AAA",
  "features": {
    "media": {
      "state": "present",
      "evidence": "index.html:203 the trim preview <video controls> plays the chosen video; src/main.ts:3229 the finished video plays in its own player; a result carries the product's own media only as chosen: the closing graphics in public/branding/ (closing-onset-*.webm, closing-tail-*.mp4; video only by ffprobe, 2026-11-27) unless No closing graphics (index.html:480), and the drawn card unless a staff video's card is unticked (index.html:314)"
    },
    "live-media": {
      "state": "absent",
      "evidence": "no getUserMedia or live stream in src/ (grep, 2026-11-27); both players play local files (index.html:203, src/main.ts:3229)"
    },
    "autoplay-audio": {
      "state": "absent",
      "evidence": "index.html:203 preload=\"metadata\" and no autoplay; src/main.ts:3224 \"nothing autoplays (spec 9.3)\""
    },
    "pdf": {
      "state": "absent",
      "evidence": "no PDF offered: the one file the page gives is the MP4 the user makes (index.html:81, src/media/save.ts:45)"
    },
    "native-ios": {
      "state": "absent",
      "evidence": "a web page only: one entry, vite.config.ts:211 input { app: index.html }; docs/01-specification.md:783 built for Chrome"
    },
    "native-android": {
      "state": "absent",
      "evidence": "a web page only: one entry, vite.config.ts:211 input { app: index.html }; docs/01-specification.md:783 built for Chrome"
    },
    "flashing": {
      "state": "absent",
      "evidence": "the product's authored media: the closings a 1 s fade or slide onset and an opaque tail (public/branding/README.md:16-21), the card a still held 5 s (src/config/cards.ts:167); the page's one keyframe animation slides the progress band (src/styles/app.css:798), no blink or flash; the user's own video is theirs (index.html:780)"
    },
    "moving-content": {
      "state": "present",
      "evidence": "src/styles/app.css:798 the indeterminate progress band moves while a video is made; src/main.ts:2301 its stage line and time left update on every report"
    },
    "authentication": {
      "state": "absent",
      "evidence": "no sign-in, account or server: docs/01-specification.md:79 \"No server\", :818 static files only"
    },
    "multi-step": {
      "state": "present",
      "evidence": "six numbered steps on one page, index.html:113 (step 1) to index.html:601 (step 6); docs/01-specification.md:588"
    },
    "timers": {
      "state": "absent",
      "evidence": "no time limit or session: the finished video stays until another video or the tab closes (index.html:682)"
    },
    "interruptions": {
      "state": "present",
      "evidence": "index.html:617 the status line announces each stage while a video is made; index.html:654 \"Announce progress\" postpones them (2.2.4)"
    },
    "pointer-gestures": {
      "state": "present",
      "evidence": "dragging: the drop zone takes a dragged file (index.html:126) and the trim handles drag (index.html:214); alternatives named at index.html:191"
    },
    "device-motion": {
      "state": "absent",
      "evidence": "no devicemotion or deviceorientation listener in src/ (grep, 2026-11-27)"
    },
    "hover-focus-content": {
      "state": "absent",
      "evidence": "index.html:497 the toggletips open by click, Enter or Space, never hover; no title attribute in index.html or src/ui; the skip link (index.html:18) shows itself on focus, no added content"
    },
    "keyboard-shortcuts": {
      "state": "absent",
      "evidence": "no printable-character shortcut: the only key handlers are Escape (src/main.ts:806, :849) and a focused trim handle's own keys (src/main.ts:2197)"
    },
    "user-input": {
      "state": "present",
      "evidence": "the file input (index.html:129), the trim times (index.html:225), the title card and submission fields (index.html:331 on), the feedback message (index.html:901)"
    },
    "page-set": {
      "state": "absent",
      "evidence": "one page: vite.config.ts:211 input { app: index.html }; the accessibility statement is on it (index.html:744)"
    },
    "languages": {
      "state": "present",
      "evidence": "the page in en-GB, zh-Hans and ms-MY (src/config/languages.ts:37), each language name in its own lang (src/ui/language-switcher.ts:71)"
    },
    "canvas": {
      "state": "absent",
      "evidence": "no <canvas> on the page; src/main.ts:2882 a canvas context only measures the title card's text"
    },
    "exports": {
      "state": "present",
      "evidence": "the finished MP4 is saved for people to use: src/media/save.ts:45 (save picker or download), :132"
    }
  },
