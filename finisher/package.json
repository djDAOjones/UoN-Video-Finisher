{
  "name": "uon-video-finisher",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Add approved UoN branding and consistent audio levels to an educational video, entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:placeholders",
    "build": "tsc --noEmit && vite build",
    "build:xerte": "npm run check:placeholders && tsc --noEmit && vite build --mode xerte",
    "package:xerte": "node scripts/package-xerte.mjs",
    "preview": "vite preview",
    "test": "node -e \"console.log('test context: an unusually long DSP timeout may be machine contention; rerun on a settled machine before changing the timeout or assertion')\" && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/a11y && node ../scripts/check-projects.mjs --project tsconfig.json --project tests/a11y/tsconfig.json --entry src/root.tsx && node ../scripts/jsdoc-ratchet.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "deadcode": "knip",
    "format": "prettier --write .",
    "docs:lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#pm_skills\"",
    "docs:links": "node check-links.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:memory": "node pm_skills/scaffold/check-memory.mjs",
    "check": "npm run check:placeholders && npm run typecheck && npm run lint && npm run test && npm run check:build && npm run docs:lint && npm run docs:links && npm run check:memory && node tools/check.mjs",
    "a11y": "node ../scripts/link-root-install.mjs . && node tools/a11y-run.mjs",
    "a11y:sample": "node ../scripts/link-root-install.mjs . && node tools/a11y-sample.mjs",
    "a11y:doctor": "node ../scripts/link-root-install.mjs . && node tools/a11y-doctor.mjs",
    "a11y:extended": "node ../scripts/link-root-install.mjs . && node tools/a11y-extended.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@carbon/react": "1.118.0",
    "@guidepup/guidepup": "0.36.4",
    "@guidepup/setup": "0.29.3",
    "@ibm/plex": "6.4.1",
    "@playwright/test": "1.56.1",
    "@types/prop-types": "15.7.15",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "axe-core": "4.13.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "knip": "6.41.0",
    "markdownlint-cli2": "^0.23.2",
    "mediabunny": "^1.55.2",
    "prettier": "^3.9.6",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sass": "1.105.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.2.2",
    "vitest": "5.1.0"
  }
}
